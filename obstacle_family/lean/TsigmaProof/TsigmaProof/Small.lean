theorem cert9_total : (cert9.map Prod.fst).sum = 23 := by decide

theorem cert9_inj : ∀ p ∈ cert9, ∀ x y, valid 0 x → valid 0 y → x ≠ y → p.2 x ≠ p.2 y := by
  have h : ∀ p ∈ cert9, ∀ x ∈ vs 0, ∀ y ∈ vs 0, x ≠ y → p.2 x ≠ p.2 y := by decide
  intro p hp x y hx hy
  exact h p hp x ((mem_vs 0 x).2 hx) y ((mem_vs 0 y).2 hy)

theorem dual9_total : (dual9.map Prod.fst).sum = 23 := by decide

theorem dual9_inj : ∀ p ∈ dual9, ∀ x y, valid 0 x → valid 0 y → x ≠ y → p.2 x ≠ p.2 y := by
  have h : ∀ p ∈ dual9, ∀ x ∈ vs 0, ∀ y ∈ vs 0, x ≠ y → p.2 x ≠ p.2 y := by decide
  intro p hp x y hx hy
  exact h p hp x ((mem_vs 0 x).2 hx) y ((mem_vs 0 y).2 hy)

theorem bob9 : BobFwd cert9 (tarc 0) (vs 0) 15 := by
  unfold BobFwd
  decide

theorem bob9_strict : ∀ x ∈ vs 0, ∀ y ∈ vs 0, tarc 0 x y → ¬ garc 0 x y →
    15 + 1 ≤ fwdWeight cert9 x y := by decide

theorem dual9_bob : ∀ x ∈ vs 0, ∀ y ∈ vs 0, garc 0 x y → 15 ≤ fwdWeight dual9 x y := by
