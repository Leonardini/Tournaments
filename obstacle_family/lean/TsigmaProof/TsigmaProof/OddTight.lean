  tight (vs k) (certList k) (36 * k + 138) (24 * k + 90) (rho k) (certList_total k hk)
    (by unfold rho; push_cast; field_simp <;> ring)
    (certList_lin k hk) (garc k) (certList_bob k hk) y hy (1, (r_C12 k))
    (List.mem_append_left _ (List.mem_append_left _ (List.mem_append_left _ (List.mem_append_left _ (List.mem_append_left _ (List.mem_append_left _ (List.mem_append_left _ (List.mem_append_left _ (List.mem_append_left _ (by simp [certListR])))))))))) (by change 0 < 1; omega)

