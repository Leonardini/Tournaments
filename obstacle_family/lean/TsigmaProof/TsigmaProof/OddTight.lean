theorem certList_bob (k : ℕ) (hk : 1 ≤ k) :
    ∀ x ∈ vs k, ∀ z ∈ vs k, garc k x z → 24 * k + 90 ≤ fwdWeight (certList k) x z :=
  fun x hx z hz h => bob k hk x hx z hz (garc_tarc k x z ((mem_vs k x).1 hx) ((mem_vs k z).1 hz) h)

theorem certList_lin (k : ℕ) (hk : 1 ≤ k) : ∀ p ∈ certList k, LinOrd (vs k) p.2 :=
  fun p hp => linOrd_of_inj k p.2 (fun x z hx hz hxz => certList_inj k hk x z hx hz hxz p hp)

