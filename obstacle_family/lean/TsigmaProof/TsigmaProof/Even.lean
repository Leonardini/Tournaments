/-- Bob's side: the weighted orders of the table, of total `c(3n - 4)`, make every arc of the
completion forward with weight at least `c(2n - 3)`. -/
theorem bob (k : ℕ) (hk : 2 ≤ k) : BobFwd (certList k) (tarc k) (vs k) (8 * k + 18) := by
  intro x _ y _ h
  have h1 := fwd_add_rev (certList k) x y (certList_inj k hk x y h.1 h.2.1 h.2.2.1)
  rw [revWeight_certList, certList_total k hk] at h1
  have h2 := (load_bound k hk x y h).1
  omega

/-- The strict half: every arc of the completion outside the obstacle is forward with weight at least
`c(2n - 3) + 1`. -/
theorem bob_strict (k : ℕ) (hk : 2 ≤ k) (x y : V) (h : tarc k x y) (hg : ¬ garc k x y) :
    8 * k + 18 + 1 ≤ fwdWeight (certList k) x y := by
  have h1 := fwd_add_rev (certList k) x y (certList_inj k hk x y h.1 h.2.1 h.2.2.1)
  rw [revWeight_certList, certList_total k hk] at h1
  have h2 := (load_bound k hk x y h).2 hg
  omega

