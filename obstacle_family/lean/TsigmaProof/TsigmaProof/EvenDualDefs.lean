  rcases x with _ | _ | _ | _ | _ | _ | a | a <;> rcases y with _ | _ | _ | _ | _ | _ | b | b <;>
    simp only [valid, r_K, ne_eq, V.U.injEq, V.W.injEq, reduceCtorEq, not_false_eq_true,
      not_true_eq_false] at hx hy hxy ⊢ <;> (try split_ifs) <;> omega

theorem r_Kst_inj (k : ℕ) (p : ℕ) (hk : 2 ≤ k) (hp : 1 ≤ p ∧ p ≤ k) (x y : V) (hx : valid k x)
    (hy : valid k y) (hxy : x ≠ y) : r_Kst k p x ≠ r_Kst k p y := by
  rcases x with _ | _ | _ | _ | _ | _ | a | a <;> rcases y with _ | _ | _ | _ | _ | _ | b | b <;>
    simp only [valid, r_Kst, ne_eq, V.U.injEq, V.W.injEq, reduceCtorEq, not_false_eq_true,
      not_true_eq_false] at hx hy hxy ⊢ <;> (try split_ifs) <;> omega

theorem r_L_inj (k : ℕ) (p : ℕ) (hk : 2 ≤ k) (hp : 1 ≤ p ∧ p ≤ k) (x y : V) (hx : valid k x)
    (hy : valid k y) (hxy : x ≠ y) : r_L k p x ≠ r_L k p y := by
  rcases x with _ | _ | _ | _ | _ | _ | a | a <;> rcases y with _ | _ | _ | _ | _ | _ | b | b <;>
    simp only [valid, r_L, ne_eq, V.U.injEq, V.W.injEq, reduceCtorEq, not_false_eq_true,
      not_true_eq_false] at hx hy hxy ⊢ <;> (try split_ifs) <;> omega

theorem r_Ljt_inj (k : ℕ) (p : ℕ) (hk : 2 ≤ k) (hp : 1 ≤ p ∧ p ≤ k - 1) (x y : V) (hx : valid k x)
    (hy : valid k y) (hxy : x ≠ y) : r_Ljt k p x ≠ r_Ljt k p y := by
  rcases x with _ | _ | _ | _ | _ | _ | a | a <;> rcases y with _ | _ | _ | _ | _ | _ | b | b <;>
    simp only [valid, r_Ljt, ne_eq, V.U.injEq, V.W.injEq, reduceCtorEq, not_false_eq_true,
      not_true_eq_false] at hx hy hxy ⊢ <;> (try split_ifs) <;> omega

/-- The orders of the table that are not in a group. -/
def dualListR (k : ℕ) : List (ℕ × (V → ℕ)) :=
  [(2 * k, r_h k),
   (1, r_Q1 k),
   (2, r_Q2 k),
   (1, r_Q3 k),
   (1, r_Q4 k),
   (1, r_Q5 k),
   (1, r_Q6 k),
   (1, r_Q7 k),
   (1, r_Q8 k),
   (1, r_Q9 k),
   (1, r_Q10 k),
   (1, r_Q11 k),
   (1, r_Q12 k),
   (1, r_Q13 k)]

/-- The orders of Table `tbl:even-dual-orders`, as a list. -/
def dualList (k : ℕ) : List (ℕ × (V → ℕ)) :=
  dualListR k
  ++ ((List.range (k + 1)).map fun t => (1, r_K k (t + 0)))
  ++ ((List.range (k)).map fun t => (1, r_Kst k (t + 1)))
  ++ ((List.range (k)).map fun t => (1, r_L k (t + 1)))
  ++ ((List.range (k - 1)).map fun t => (1, r_Ljt k (t + 1)))

theorem dualListR_total (k : ℕ) : ((dualListR k).map Prod.fst).sum = 2 * k + 14 := by
  simp only [dualListR, List.map_cons, List.map_nil, List.sum_cons, List.sum_nil]
  ring

theorem dualListR_inj (k : ℕ) (hk : 2 ≤ k) (x y : V) (hx : valid k x) (hy : valid k y) (hxy : x ≠ y) :
    ∀ p ∈ dualListR k, p.2 x ≠ p.2 y := by
  simp only [dualListR, List.forall_mem_cons]
  exact ⟨r_h_inj k hk x y hx hy hxy,
    r_Q1_inj k hk x y hx hy hxy,
    r_Q2_inj k hk x y hx hy hxy,
    r_Q3_inj k hk x y hx hy hxy,
    r_Q4_inj k hk x y hx hy hxy,
    r_Q5_inj k hk x y hx hy hxy,
    r_Q6_inj k hk x y hx hy hxy,
    r_Q7_inj k hk x y hx hy hxy,
    r_Q8_inj k hk x y hx hy hxy,
    r_Q9_inj k hk x y hx hy hxy,
    r_Q10_inj k hk x y hx hy hxy,
    r_Q11_inj k hk x y hx hy hxy,
    r_Q12_inj k hk x y hx hy hxy,
    r_Q13_inj k hk x y hx hy hxy,
    fun _ h => absurd h List.not_mem_nil⟩

theorem dualList_inj (k : ℕ) (hk : 2 ≤ k) (x y : V) (hx : valid k x) (hy : valid k y) (hxy : x ≠ y) :
    ∀ p ∈ dualList k, p.2 x ≠ p.2 y := by
  intro p hp
  simp only [dualList, List.mem_append] at hp
  rcases hp with (((hp | hp) | hp) | hp) | hp
  · exact dualListR_inj k hk x y hx hy hxy p hp
  · obtain ⟨t, ht, rfl⟩ := List.mem_map.1 hp
    have ht' := List.mem_range.1 ht
    exact r_K_inj k (t + 0) hk ⟨by omega, by omega⟩ x y hx hy hxy
  · obtain ⟨t, ht, rfl⟩ := List.mem_map.1 hp
    have ht' := List.mem_range.1 ht
    exact r_Kst_inj k (t + 1) hk ⟨by omega, by omega⟩ x y hx hy hxy
  · obtain ⟨t, ht, rfl⟩ := List.mem_map.1 hp
    have ht' := List.mem_range.1 ht
    exact r_L_inj k (t + 1) hk ⟨by omega, by omega⟩ x y hx hy hxy
  · obtain ⟨t, ht, rfl⟩ := List.mem_map.1 hp
    have ht' := List.mem_range.1 ht
    exact r_Ljt_inj k (t + 1) hk ⟨by omega, by omega⟩ x y hx hy hxy

theorem revWeight_dualList (k : ℕ) (x y : V) : revWeight (dualList k) x y = dload k x y := by
  simp only [revWeight, dualList, dualListR, dload, famsum, List.map_append, List.sum_append,
    List.map_cons, List.sum_cons, List.map_nil, List.sum_nil, List.map_map, Function.comp_def,
    List.sum_map_mul_left]
  ring

theorem dualList_total (k : ℕ) (hk : 2 ≤ k) : ((dualList k).map Prod.fst).sum = 6 * k + 14 := by
  simp only [dualList, List.map_append, List.sum_append, dualListR_total, List.map_map,
    Function.comp_def, sum_map_range_const]
  omega

/-- The automorphism `φ = (T1 T2)(P1 P2)` of `G_n`. -/
def phi : V → V
  | .T1 => .T2
  | .T2 => .T1
  | .P1 => .P2
  | .P2 => .P1
  | v => v

theorem phi_phi (v : V) : phi (phi v) = v := by cases v <;> rfl

theorem phi_ne {x z : V} (h : x ≠ z) : phi x ≠ phi z := fun e => h (by rw [← phi_phi x, e, phi_phi])

theorem valid_phi (k : ℕ) (v : V) (h : valid k v) : valid k (phi v) := by
  cases v <;> simp_all [phi, valid]

theorem garc_phi (k : ℕ) (x z : V) (h : garc k x z) : garc k (phi x) (phi z) := by
  rcases x with _ | _ | _ | _ | _ | _ | a | a <;> rcases z with _ | _ | _ | _ | _ | _ | b | b <;>
    simp_all [garc, phi]

theorem mem_vs_phi (k : ℕ) (v : V) (h : v ∈ vs k) : phi v ∈ vs k :=
  (mem_vs k _).2 (valid_phi k v ((mem_vs k v).1 h))

theorem fwdWeight_phi (L : List (ℕ × (V → ℕ))) (x z : V) :
    fwdWeight (L.map (fun p => (p.1, fun v => p.2 (phi v)))) x z = fwdWeight L (phi x) (phi z) := by
  induction L with
  | nil => rfl
  | cons p L ih =>
    simp only [fwdWeight, List.map_cons, List.sum_cons] at ih ⊢
    rw [ih]

end Tsigma.Even
