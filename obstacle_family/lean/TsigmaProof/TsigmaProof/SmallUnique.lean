theorem rho8 : rho 1 = 13 / 20 := by unfold rho; norm_num

theorem tc8 (y : V → V → ℚ) (hy : AliceOpt (vs 1) (garc 1) (rho 1) y) : ∀ p ∈ cert8, 0 < p.1 → fwdQ (vs 1) p.2 y = rho 1 :=
  tight (vs 1) cert8 20 13 (rho 1) cert8_total (by unfold rho; norm_num)
    (fun p hp => linOrd_of_inj 1 p.2 (fun x z hx hz hxz => cert8_inj p hp x z hx hz hxz))
    (garc 1) (fun x hx z hz h => bob8 x hx z hz
      (garc_tarc 1 x z ((mem_vs 1 x).1 hx) ((mem_vs 1 z).1 hz) h)) y hy

theorem td8 (y : V → V → ℚ) (hy : AliceOpt (vs 1) (garc 1) (rho 1) y) : ∀ p ∈ dual8, 0 < p.1 → fwdQ (vs 1) p.2 y = rho 1 :=
