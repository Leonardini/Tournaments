namespace Tsigma

namespace Odd

theorem psum_garc0 (f : V → V → ℚ) (hf : ∀ x z, f x z ≠ 0 → garc 0 x z) :
    psum (vs 0) f = (oarcs0.map (fun q => f q.1.1 q.1.2)).sum := by
  have hm : ∀ x ∈ vs 0, ∀ z ∈ vs 0, garc 0 x z → (x, z) ∈ oarcs0.map Prod.fst := by decide
  rw [psum_eq_list (vs 0) (oarcs0.map Prod.fst) (by decide) (by decide) f
    (fun x hx z hz h => hm x hx z hz (hf x z h)), List.map_map]
  rfl

theorem fwdQ_garc0 (r : V → ℕ) (y : V → V → ℚ) (hy : ∀ x z, y x z ≠ 0 → garc 0 x z) :
    fwdQ (vs 0) r y = (oarcs0.map (fun q => if r q.1.1 < r q.1.2 then y q.1.1 q.1.2 else 0)).sum :=
  psum_garc0 _ (fun x z h => by
    by_cases hr : r x < r z
    · rw [if_pos hr] at h; exact hy x z h
    · rw [if_neg hr] at h; exact absurd rfl h)

end Odd

