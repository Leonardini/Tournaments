import TsigmaProof.Common

/-! # The odd family: definitions, and the strict certificate for the completion of `H_{2k+9}`

Generated by `Lean/gen_lean.py` from Table `tbl:odd-orders` of paper 1 (an order listed more than once
appears once, with its weights added). -/

namespace Tsigma.Odd

inductive V where
  | N0 | N1 | N2 | N3 | P1 | P2 | F | G | H | U (i : ℕ) | W (i : ℕ)
  deriving DecidableEq

/-- The vertices: the fixed ones and `U i`, `W i` for `1 ≤ i ≤ k`. -/
def valid (k : ℕ) : V → Prop
  | .U i => 1 ≤ i ∧ i ≤ k
  | .W i => 1 ≤ i ∧ i ≤ k
  | _ => True

/-- The arcs of `H_{2k+9}` (Section sec:family-def): the zigzag path `P1, W1, U1, ..., Wk, Uk, H`,
the arcs at the hubs `N1` and `N2`, and eighteen more. -/
def garc (k : ℕ) : V → V → Prop
  | .N0, .N2 => True
  | .N0, .N3 => True
  | .N1, .N2 => True
  | .N1, .N3 => True
  | .N2, .N3 => True
  | .P1, .N0 => True
  | .N0, .P2 => True
  | .N2, .P2 => True
  | .P2, .N1 => True
  | .P2, .G => True
  | .N2, .F => True
  | .N3, .F => True
  | .F, .N0 => True
  | .F, .N1 => True
  | .N3, .G => True
  | .G, .N0 => True
  | .G, .N2 => True
  | .N3, .H => True
  | .N1, .P1 => True
  | .N2, .P1 => True
  | .H, .N1 => True
  | .H, .N2 => True
  | .N1, .U i => 1 ≤ i ∧ i ≤ k
  | .N2, .U i => 1 ≤ i ∧ i ≤ k
  | .W i, .N1 => 1 ≤ i ∧ i ≤ k
  | .W i, .N2 => 1 ≤ i ∧ i ≤ k
  | .P1, .W j => j = 1 ∧ 1 ≤ k
  | .P1, .H => k = 0
  | .U i, .W j => 1 ≤ i ∧ ((j = i ∧ i ≤ k) ∨ (j = i + 1 ∧ i + 1 ≤ k))
  | .U i, .H => i = k ∧ 1 ≤ k
  | _, _ => False

/-- The order along which `H_{2k+9}` is completed:
`N2, W1, ..., Wk, N3, F, H, P1, P2, N1, G, N0, U1, ..., Uk`. -/
def sigma (k : ℕ) : V → ℕ
  | .N2 => 0
  | .W i => i
  | .N3 => k + 1
  | .F => k + 2
  | .H => k + 3
  | .P1 => k + 4
  | .P2 => k + 5
  | .N1 => k + 6
  | .G => k + 7
  | .N0 => k + 8
  | .U i => k + 8 + i

/-- The arcs of the completion: those of the obstacle, and every other pair as in `sigma`. -/
def tarc (k : ℕ) (x y : V) : Prop :=
  valid k x ∧ valid k y ∧ x ≠ y ∧ (garc k x y ∨ (¬ garc k y x ∧ sigma k x < sigma k y))

instance (k : ℕ) (v : V) : Decidable (valid k v) := by unfold valid; split <;> infer_instance
instance (k : ℕ) (x y : V) : Decidable (garc k x y) := by unfold garc; split <;> infer_instance
instance (k : ℕ) (x y : V) : Decidable (tarc k x y) := by unfold tarc; infer_instance

