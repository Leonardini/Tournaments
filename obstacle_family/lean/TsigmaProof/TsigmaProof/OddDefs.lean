/-- The load of `x → y`: the total weight of the orders in which it is backward. -/
def load (k : ℕ) (x y : V) : ℕ :=
  (k) * ind (r_A1 k) x y
  + (6 * k + 6) * ind (r_A2 k) x y
  + (2) * ind (r_A3 k) x y
  + (1) * ind (r_A4 k) x y
  + (1) * ind (r_A5 k) x y
  + (1) * ind (r_A7 k) x y
  + (1) * ind (r_A8 k) x y
  + (1) * ind (r_A9 k) x y
