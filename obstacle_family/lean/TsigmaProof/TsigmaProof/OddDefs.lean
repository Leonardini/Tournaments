def certList (k : ℕ) : List (ℕ × (V → ℕ)) :=
  certListR k
  ++ ((List.range (k + 1)).map fun t => (4, r_AE1 k (t + 0)))
  ++ ((List.range (k + 1)).map fun t => (2, r_AE2 k (t + 0)))
  ++ ((List.range (k)).map fun t => (4, r_AD1 k (t + 0)))
  ++ ((List.range (k)).map fun t => (2, r_AD2 k (t + 0)))
  ++ ((List.range (k + 1)).map fun t => (2, r_BE1 k (t + 0)))
