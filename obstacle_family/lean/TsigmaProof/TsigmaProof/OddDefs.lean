theorem certList_inj (k : ℕ) (hk : 1 ≤ k) (x y : V) (hx : valid k x) (hy : valid k y) (hxy : x ≠ y) :
    ∀ p ∈ certList k, p.2 x ≠ p.2 y := by
  intro p hp
  simp only [certList, List.mem_append] at hp
  rcases hp with ((((((((hp | hp) | hp) | hp) | hp) | hp) | hp) | hp) | hp) | hp
  · exact certListR_inj k hk x y hx hy hxy p hp
  · obtain ⟨t, ht, rfl⟩ := List.mem_map.1 hp
    have ht' := List.mem_range.1 ht
    exact r_AE1_inj k (t + 0) hk ⟨by omega, by omega⟩ x y hx hy hxy
  · obtain ⟨t, ht, rfl⟩ := List.mem_map.1 hp
    have ht' := List.mem_range.1 ht
    exact r_AE2_inj k (t + 0) hk ⟨by omega, by omega⟩ x y hx hy hxy
  · obtain ⟨t, ht, rfl⟩ := List.mem_map.1 hp
    have ht' := List.mem_range.1 ht
    exact r_AD1_inj k (t + 0) hk ⟨by omega, by omega⟩ x y hx hy hxy
  · obtain ⟨t, ht, rfl⟩ := List.mem_map.1 hp
    have ht' := List.mem_range.1 ht
    exact r_AD2_inj k (t + 0) hk ⟨by omega, by omega⟩ x y hx hy hxy
  · obtain ⟨t, ht, rfl⟩ := List.mem_map.1 hp
    have ht' := List.mem_range.1 ht
    exact r_BE1_inj k (t + 0) hk ⟨by omega, by omega⟩ x y hx hy hxy
  · obtain ⟨t, ht, rfl⟩ := List.mem_map.1 hp
    have ht' := List.mem_range.1 ht
    exact r_BE2_inj k (t + 0) hk ⟨by omega, by omega⟩ x y hx hy hxy
  · obtain ⟨t, ht, rfl⟩ := List.mem_map.1 hp
