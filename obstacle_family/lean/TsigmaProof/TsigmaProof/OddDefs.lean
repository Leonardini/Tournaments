  ++ ((List.range (k)).map fun t => (2, r_BD1 k (t + 0)))
  ++ ((List.range (k)).map fun t => (2, r_BD2 k (t + 0)))
  ++ ((List.range (k)).map fun t => (2, r_CD2 k (t + 0)))

theorem certListR_total (k : ℕ) : ((certListR k).map Prod.fst).sum = 12 * k + 126 := by
  simp only [certListR, List.map_cons, List.map_nil, List.sum_cons, List.sum_nil]
  ring

