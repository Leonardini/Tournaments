/-- The vertices, as a list. -/
def vs (k : ℕ) : List V :=
  [.N0, .N1, .N2, .N3, .P1, .P2, .F, .G, .H] ++ (List.range k).map (fun t => .U (t + 1)) ++ (List.range k).map (fun t => .W (t + 1))

theorem mem_vs (k : ℕ) (x : V) : x ∈ vs k ↔ valid k x := by
  rcases x with _ | _ | _ | _ | _ | _ | _ | _ | _ | i | i
  · simp [vs, valid]
  · simp [vs, valid]
  · simp [vs, valid]
  · simp [vs, valid]
  · simp [vs, valid]
  · simp [vs, valid]
  · simp [vs, valid]
  · simp [vs, valid]
  · simp [vs, valid]
  · simp only [vs, valid, List.mem_append, List.mem_map, List.mem_range, List.mem_cons, reduceCtorEq,
      V.U.injEq, List.not_mem_nil, or_false, false_or, and_false, exists_false]
    constructor
    · rintro ⟨t, ht, h⟩
      omega
    · intro h
      exact ⟨i - 1, by omega, by omega⟩
  · simp only [vs, valid, List.mem_append, List.mem_map, List.mem_range, List.mem_cons, reduceCtorEq,
      V.W.injEq, List.not_mem_nil, or_false, false_or, and_false, exists_false]
    constructor
    · rintro ⟨t, ht, h⟩
      omega
    · intro h
      exact ⟨i - 1, by omega, by omega⟩

theorem revWeight_certList (k : ℕ) (x y : V) : revWeight (certList k) x y = load k x y := by
  simp only [revWeight, certList, certListR, load, famsum, List.map_append, List.sum_append, List.map_cons,
    List.sum_cons, List.map_nil, List.sum_nil, List.map_map, Function.comp_def, List.sum_map_mul_left]
  ring

theorem certList_total (k : ℕ) (hk : 1 ≤ k) : ((certList k).map Prod.fst).sum = 36 * k + 138 := by
  simp only [certList, List.map_append, List.sum_append, certListR_total, List.map_map,
    Function.comp_def, sum_map_range_const]
  omega

