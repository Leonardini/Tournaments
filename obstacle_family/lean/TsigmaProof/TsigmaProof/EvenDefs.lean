/-- The orders of the table that are not in a group. -/
def certListR (k : ℕ) : List (ℕ × (V → ℕ)) :=
  [(1, r_R1 k),
   (2 * k + 1, r_R2 k),
   (1, r_R3 k),
   (2 * k, r_R4 k),
   (1, r_R5 k),
   (1, r_R6 k),
   (1, r_R7 k),
   (2, r_R8 k),
   (1, r_R9 k),
   (1, r_R10 k),
   (2, r_R11 k),
   (1, r_R12 k),
   (1, r_R13 k),
   (1, r_R14 k),
   (1, r_R15 k),
   (1, r_R16 k),
   (2, r_R17 k),
   (2, r_R18 k),
   (1, r_R19 k),
   (1, r_R20 k),
   (3, r_R21 k)]

/-- The weighted orders of the table, as a list. -/
def certList (k : ℕ) : List (ℕ × (V → ℕ)) :=
  certListR k
  ++ ((List.range (k + 1)).map fun t => (1, r_A k (t + 0)))
  ++ ((List.range (k + 1)).map fun t => (1, r_Ap k (t + 0)))
  ++ ((List.range (k)).map fun t => (1, r_B k (t + 0)))
  ++ ((List.range (k)).map fun t => (1, r_Bp k (t + 0)))
  ++ ((List.range (k)).map fun t => (1, r_C k (t + 0)))
  ++ ((List.range (k)).map fun t => (2, r_Cp k (t + 0)))
  ++ ((List.range (k)).map fun t => (1, r_Cpp k (t + 0)))

theorem certListR_total (k : ℕ) : ((certListR k).map Prod.fst).sum = 4 * k + 26 := by
  simp only [certListR, List.map_cons, List.map_nil, List.sum_cons, List.sum_nil]
  ring

theorem certListR_inj (k : ℕ) (hk : 2 ≤ k) (x y : V) (hx : valid k x) (hy : valid k y) (hxy : x ≠ y) :
    ∀ p ∈ certListR k, p.2 x ≠ p.2 y := by
  simp only [certListR, List.forall_mem_cons]
  exact ⟨r_R1_inj k hk x y hx hy hxy,
    r_R2_inj k hk x y hx hy hxy,
    r_R3_inj k hk x y hx hy hxy,
    r_R4_inj k hk x y hx hy hxy,
    r_R5_inj k hk x y hx hy hxy,
    r_R6_inj k hk x y hx hy hxy,
    r_R7_inj k hk x y hx hy hxy,
    r_R8_inj k hk x y hx hy hxy,
    r_R9_inj k hk x y hx hy hxy,
    r_R10_inj k hk x y hx hy hxy,
    r_R11_inj k hk x y hx hy hxy,
    r_R12_inj k hk x y hx hy hxy,
    r_R13_inj k hk x y hx hy hxy,
    r_R14_inj k hk x y hx hy hxy,
    r_R15_inj k hk x y hx hy hxy,
    r_R16_inj k hk x y hx hy hxy,
    r_R17_inj k hk x y hx hy hxy,
    r_R18_inj k hk x y hx hy hxy,
    r_R19_inj k hk x y hx hy hxy,
    r_R20_inj k hk x y hx hy hxy,
    r_R21_inj k hk x y hx hy hxy,
    fun _ h => absurd h List.not_mem_nil⟩

theorem certList_inj (k : ℕ) (hk : 2 ≤ k) (x y : V) (hx : valid k x) (hy : valid k y) (hxy : x ≠ y) :
    ∀ p ∈ certList k, p.2 x ≠ p.2 y := by
  intro p hp
  simp only [certList, List.mem_append] at hp
  rcases hp with ((((((hp | hp) | hp) | hp) | hp) | hp) | hp) | hp
  · exact certListR_inj k hk x y hx hy hxy p hp
  · obtain ⟨t, ht, rfl⟩ := List.mem_map.1 hp
    have ht' := List.mem_range.1 ht
    exact r_A_inj k (t + 0) hk ⟨by omega, by omega⟩ x y hx hy hxy
  · obtain ⟨t, ht, rfl⟩ := List.mem_map.1 hp
    have ht' := List.mem_range.1 ht
    exact r_Ap_inj k (t + 0) hk ⟨by omega, by omega⟩ x y hx hy hxy
  · obtain ⟨t, ht, rfl⟩ := List.mem_map.1 hp
    have ht' := List.mem_range.1 ht
    exact r_B_inj k (t + 0) hk ⟨by omega, by omega⟩ x y hx hy hxy
  · obtain ⟨t, ht, rfl⟩ := List.mem_map.1 hp
    have ht' := List.mem_range.1 ht
    exact r_Bp_inj k (t + 0) hk ⟨by omega, by omega⟩ x y hx hy hxy
  · obtain ⟨t, ht, rfl⟩ := List.mem_map.1 hp
    have ht' := List.mem_range.1 ht
    exact r_C_inj k (t + 0) hk ⟨by omega, by omega⟩ x y hx hy hxy
  · obtain ⟨t, ht, rfl⟩ := List.mem_map.1 hp
    have ht' := List.mem_range.1 ht
    exact r_Cp_inj k (t + 0) hk ⟨by omega, by omega⟩ x y hx hy hxy
  · obtain ⟨t, ht, rfl⟩ := List.mem_map.1 hp
    have ht' := List.mem_range.1 ht
    exact r_Cpp_inj k (t + 0) hk ⟨by omega, by omega⟩ x y hx hy hxy

/-- The vertices, as a list. -/
def vs (k : ℕ) : List V :=
  [.T0, .T1, .T2, .T3, .P1, .P2] ++ (List.range k).map (fun t => .U (t + 1)) ++ (List.range k).map (fun t => .W (t + 1))

theorem mem_vs (k : ℕ) (x : V) : x ∈ vs k ↔ valid k x := by
  rcases x with _ | _ | _ | _ | _ | _ | i | i
  · simp [vs, valid]
  · simp [vs, valid]
  · simp [vs, valid]
  · simp [vs, valid]
  · simp [vs, valid]
  · simp [vs, valid]
  · simp only [vs, valid, List.mem_append, List.mem_map, List.mem_range, List.mem_cons, reduceCtorEq,
      V.U.injEq, List.not_mem_nil, or_false, false_or, and_false, exists_false]
    constructor
    · rintro ⟨t, ht, h⟩
      omega
    · intro h
      exact ⟨i - 1, by omega, by omega⟩
  · simp only [vs, valid, List.mem_append, List.mem_map, List.mem_range, List.mem_cons, reduceCtorEq,
      V.W.injEq, List.not_mem_nil, or_false, false_or, and_false, exists_false]
    constructor
    · rintro ⟨t, ht, h⟩
      omega
    · intro h
      exact ⟨i - 1, by omega, by omega⟩

theorem revWeight_certList (k : ℕ) (x y : V) : revWeight (certList k) x y = load k x y := by
  simp only [revWeight, certList, certListR, load, famsum, List.map_append, List.sum_append, List.map_cons,
    List.sum_cons, List.map_nil, List.sum_nil, List.map_map, Function.comp_def, List.sum_map_mul_left]
  ring

theorem certList_total (k : ℕ) (hk : 2 ≤ k) : ((certList k).map Prod.fst).sum = 12 * k + 28 := by
  simp only [certList, List.map_append, List.sum_append, certListR_total, List.map_map,
    Function.comp_def, sum_map_range_const]
  omega

end Tsigma.Even
