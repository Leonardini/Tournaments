import TsigmaProof.Common

/-! # The even family: definitions, and the strict certificate for the completion of `G_{2k+6}`

Generated by `Lean/gen_lean.py` from Table `tbl:even-orders` of paper 1 (an order listed more than once
appears once, with its weights added). -/

namespace Tsigma.Even

inductive V where
  | T0 | T1 | T2 | T3 | P1 | P2 | U (i : ℕ) | W (i : ℕ)
  deriving DecidableEq

/-- The vertices: the fixed ones and `U i`, `W i` for `1 ≤ i ≤ k`. -/
def valid (k : ℕ) : V → Prop
  | .U i => 1 ≤ i ∧ i ≤ k
  | .W i => 1 ≤ i ∧ i ≤ k
  | _ => True

/-- The arcs of `G_{2k+6}` (Section sec:family-def): the zigzag path `T0, U1, W1, ..., Uk, Wk, T3`,
the arcs at the hubs `T1` and `T2`, and nine more. -/
def garc (k : ℕ) : V → V → Prop
  | .T0, .T3 => True
  | .T2, .P1 => True
  | .T3, .P1 => True
  | .P1, .T0 => True
  | .P1, .T1 => True
  | .T1, .P2 => True
  | .T3, .P2 => True
  | .P2, .T0 => True
  | .P2, .T2 => True
  | .T0, .T1 => True
  | .T0, .T2 => True
  | .T1, .T3 => True
  | .T2, .T3 => True
  | .T1, .U i => 1 ≤ i ∧ i ≤ k
  | .T2, .U i => 1 ≤ i ∧ i ≤ k
  | .W i, .T1 => 1 ≤ i ∧ i ≤ k
  | .W i, .T2 => 1 ≤ i ∧ i ≤ k
  | .U i, .W j => 1 ≤ j ∧ ((i = j ∧ j ≤ k) ∨ (i = j + 1 ∧ j + 1 ≤ k))
  | .U i, .T0 => i = 1
  | .T3, .W j => j = k
  | _, _ => False

/-- The order along which `G_{2k+6}` is completed:
`T2, W1, ..., Wk, U1, T1, T0, P1, T3, P2, U2, ..., Uk`. -/
def sigma (k : ℕ) : V → ℕ
  | .T2 => 0
  | .W i => i
  | .U i => if i = 1 then k + 1 else k + 5 + i
  | .T1 => k + 2
  | .T0 => k + 3
  | .P1 => k + 4
  | .T3 => k + 5
  | .P2 => k + 6

/-- The arcs of the completion: those of the obstacle, and every other pair as in `sigma`. -/
def tarc (k : ℕ) (x y : V) : Prop :=
  valid k x ∧ valid k y ∧ x ≠ y ∧ (garc k x y ∨ (¬ garc k y x ∧ sigma k x < sigma k y))

instance (k : ℕ) (v : V) : Decidable (valid k v) := by unfold valid; split <;> infer_instance
instance (k : ℕ) (x y : V) : Decidable (garc k x y) := by unfold garc; split <;> infer_instance
instance (k : ℕ) (x y : V) : Decidable (tarc k x y) := by unfold tarc; infer_instance

