  | .P1 => 2 * (4 * k + 8) + (0)
  | .P2 => 9 * (4 * k + 8) + (0)
  | .U i => if i = 1 then 1 * (4 * k + 8) + (0) else if 2 ≤ i ∧ i < p + 2 then 4 * (4 * k + 8) + (4 * i + 1) else 6 * (4 * k + 8) + (4 * i + 1)
  | .W i => if i = k then 8 * (4 * k + 8) + (0) else if i + 1 ≤ k ∧ i < p + 1 then 4 * (4 * k + 8) + (4 * i + 7) else 6 * (4 * k + 8) + (4 * i + 7)

/-- The load of `x → y`: the total weight of the orders in which it is backward. -/
def load (k : ℕ) (x y : V) : ℕ :=
  (1) * ind (r_R1 k) x y
  + (2 * k + 1) * ind (r_R2 k) x y
  + (1) * ind (r_R3 k) x y
  + (2 * k) * ind (r_R4 k) x y
  + (1) * ind (r_R5 k) x y
  + (1) * ind (r_R6 k) x y
  + (1) * ind (r_R7 k) x y
  + (2) * ind (r_R8 k) x y
  + (1) * ind (r_R9 k) x y
  + (1) * ind (r_R10 k) x y
  + (2) * ind (r_R11 k) x y
  + (1) * ind (r_R12 k) x y
  + (1) * ind (r_R13 k) x y
  + (1) * ind (r_R14 k) x y
  + (1) * ind (r_R15 k) x y
  + (1) * ind (r_R16 k) x y
  + (2) * ind (r_R17 k) x y
  + (2) * ind (r_R18 k) x y
  + (1) * ind (r_R19 k) x y
  + (1) * ind (r_R20 k) x y
  + (3) * ind (r_R21 k) x y
  + (1) * famsum (fun t => r_A k (t + 0)) (k + 1) x y
  + (1) * famsum (fun t => r_Ap k (t + 0)) (k + 1) x y
  + (1) * famsum (fun t => r_B k (t + 0)) (k) x y
  + (1) * famsum (fun t => r_Bp k (t + 0)) (k) x y
  + (1) * famsum (fun t => r_C k (t + 0)) (k) x y
  + (2) * famsum (fun t => r_Cp k (t + 0)) (k) x y
  + (1) * famsum (fun t => r_Cpp k (t + 0)) (k) x y

